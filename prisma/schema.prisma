// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Models here mirror docs/superpowers/specs/reckon-spec.md — keep both in sync.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum ExpenseSource {
  MANUAL
  RECEIPT_AI
}

enum SplitType {
  EQUAL
  CUSTOM
}

enum SettlementStatus {
  PENDING
  PAY_MARKED
  CONFIRMED
}

// Where a guest's share sits. Only PAID takes it off the group's books —
// see src/lib/guest-shares.ts for why an intention isn't enough.
enum GuestStatus {
  UNDECIDED
  PAYING
  PAID
  DECLINED
}

enum ChoreFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ProposalStatus {
  PROPOSED
  AGREED
  REJECTED
}

enum FlagReason {
  OVER_BUDGET
  DIETARY_CONFLICT
}

enum VoteChoice {
  YES
  IF_NEEDED
  NO
}

enum NudgeChannel {
  EMAIL
}

enum ActivityType {
  EXPENSE_ADDED
  SETTLEMENT_PAID
  SETTLEMENT_CONFIRMED
  CHORE_COMPLETED
  PROPOSAL_AGREED
}

// ── Models ─────────────────────────────────────────────

model User {
  id                    String   @id @default(cuid())
  clerkId               String   @unique
  email                 String   @unique
  displayName           String
  avatarUrl             String?
  budgetLimit           Decimal? @db.Decimal(10, 2)
  dietaryRestrictions   String[] @default([])
  homeLatitude          Float?
  homeLongitude         Float?
  venmoHandle           String?
  paypalHandle          String?
  cashappHandle         String?
  easypaisaNumber       String?
  jazzcashNumber        String?
  nayapayHandle         String?
  bankDetails           String?
  locale                String   @default("en")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  groupMemberships      GroupMember[]
  createdGroups         Group[]                  @relation("GroupCreator")
  paidExpenses          Expense[]                @relation("ExpensePayer")
  expenseParticipations ExpenseItemParticipant[]
  settlementsOwed       Settlement[]             @relation("SettlementFrom")
  settlementsReceived   Settlement[]             @relation("SettlementTo")
  paymentsMade          Payment[]                @relation("PaymentFrom")
  paymentsReceived      Payment[]                @relation("PaymentTo")
  choreSwapPasses       ChoreSwapPass[]
  iousOwed              IOU[]                    @relation("IOUFrom")
  iousLent              IOU[]                    @relation("IOUTo")
  choreAssignments      ChoreAssignment[]
  availabilityEntries   AvailabilityEntry[]
  proposalsCreated      Proposal[]               @relation("ProposalCreator")
  proposalFlags         ProposalFlag[]
  proposalVotes         ProposalVote[]
  guestsHosted          ExpenseGuestHost[]

  @@index([email])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  currency    String   @default("USD")
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members             GroupMember[]
  expenses            Expense[]
  settlements         Settlement[]
  payments            Payment[]
  choreSwaps          ChoreSwapRequest[]
  ious                IOU[]
  chores              Chore[]
  availabilityEntries AvailabilityEntry[]
  proposals           Proposal[]
  activityEvents      ActivityEvent[]
  recaps              Recap[]

  @@index([createdById])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

// Someone without an account who was part of exactly one expense. Replaces
// the old GuestToken, which was only a share link and carried no answer —
// so a guest counted for nothing and the group silently ate their share.
//
// The token is still the whole credential (same trust model as
// Settlement.confirmToken): whoever holds the link is that guest.
model ExpenseGuest {
  id         String      @id @default(cuid())
  token      String      @unique
  expenseId  String
  expense    Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  status     GuestStatus @default(UNDECIDED)
  // True when nobody chose these hosts — the migration from GuestToken had to
  // put the share somewhere, so it guessed. The UI says so rather than
  // presenting a guess as a decision someone made.
  hostsAssumed Boolean   @default(false)
  // When the guest last answered. Kept for the activity trail — status alone
  // can't say whether "undecided" means fresh or ignored for a fortnight.
  resolvedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  hosts ExpenseGuestHost[]

  @@index([expenseId])
  @@index([token])
}

// The members who brought a guest, and who cover that guest's share if it
// never gets paid. Its own table rather than a string array so a host is a
// real foreign key — a member who can't be resolved to a person can't be
// handed someone else's debt.
model ExpenseGuestHost {
  guestId String
  guest   ExpenseGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([guestId, userId])
  @@index([userId])
}

model Expense {
  id              String        @id @default(cuid())
  groupId         String
  group           Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidById        String
  paidBy          User          @relation("ExpensePayer", fields: [paidById], references: [id])
  title           String
  totalAmount     Decimal       @db.Decimal(10, 2)
  receiptImageUrl String?
  isRecurring     Boolean       @default(false)
  recurrenceRule  String?
  source          ExpenseSource @default(MANUAL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items       ExpenseItem[]
  guests      ExpenseGuest[]

  @@index([groupId, createdAt])
  @@index([paidById])
}

model ExpenseItem {
  id        String    @id @default(cuid())
  expenseId String
  expense   Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal   @db.Decimal(10, 2)
  splitType SplitType @default(EQUAL)
  createdAt DateTime  @default(now())

  participants ExpenseItemParticipant[]

  @@index([expenseId])
}

model ExpenseItemParticipant {
  id            String      @id @default(cuid())
  expenseItemId String
  expenseItem   ExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  shareRatio    Decimal     @db.Decimal(5, 4)

  @@unique([expenseItemId, userId])
}

// Money that has actually changed hands, written down once and never
// recalculated. Everything else in this schema is derived: balances come from
// expenses and IOUs, and Settlement rows are rebuilt from scratch whenever
// anything moves. That left confirming a payment as nothing but a status flag,
// so the next recalculation worked out the debt from the expenses again and
// asked the same person for the same money a second time.
//
// This is the ledger's memory. Rows are only ever added.
model Payment {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User     @relation("PaymentFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("PaymentTo", fields: [toUserId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  // The settlement this cleared, when it came from one. Kept so a payment
  // can't be recorded twice for the same settle cycle.
  settlementId String? @unique
  confirmedAt DateTime @default(now())

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Settlement {
  id             String           @id @default(cuid())
  groupId        String
  group          Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User             @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User             @relation("SettlementTo", fields: [toUserId], references: [id])
  amount         Decimal          @db.Decimal(10, 2)
  explanation    Json
  status         SettlementStatus @default(PENDING)
  nudgeCount     Int              @default(0)
  lastNudgedAt   DateTime?
  confirmToken   String?          @unique
  confirmTokenExpiresAt DateTime?
  recalculatedAt DateTime         @updatedAt

  nudges Nudge[]

  @@unique([groupId, fromUserId, toUserId])
  @@index([groupId, status])
  @@index([fromUserId])
  @@index([toUserId])
}

model IOU {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("IOUFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("IOUTo", fields: [toUserId], references: [id])
  amount     Decimal   @db.Decimal(10, 2)
  note       String?
  forgivenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([groupId])
}

model Chore {
  id           String         @id @default(cuid())
  groupId      String
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  effortWeight Int            @default(1)
  frequency    ChoreFrequency @default(WEEKLY)
  createdAt    DateTime       @default(now())

  assignments ChoreAssignment[]

  @@index([groupId])
}

model ChoreAssignment {
  id          String    @id @default(cuid())
  choreId     String
  chore       Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  completedAt DateTime?
  explanation Json

  swapsOffered  ChoreSwapRequest[] @relation("SwapFrom")
  swapsReceived ChoreSwapRequest[] @relation("SwapTo")

  @@index([choreId, periodStart])
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  // Everyone who could have taken an open call passed on it. Distinct from
  // CANCELLED: the asker didn't change their mind, the group answered.
  NO_TAKERS
}

// "I'll do yours if you do mine." Rotation is fair on average but any single
// round can hand you the job you particularly hate, and the answer to that
// shouldn't be to distort the fairness maths — it should be to let two people
// agree between themselves.
//
// Accepting swaps the two assignees. Nothing else needs to change: effort is
// credited when a chore is COMPLETED, so the ledger already follows whoever
// actually did the work. That also makes it ungameable — someone who keeps
// swapping away heavy jobs banks less effort, so the next rotation hands them
// the heavy ones. It corrects itself without a single rule about swapping.
model ChoreSwapRequest {
  id               String     @id @default(cuid())
  groupId          String
  group            Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromAssignmentId String
  fromAssignment   ChoreAssignment @relation("SwapFrom", fields: [fromAssignmentId], references: [id], onDelete: Cascade)
  // Null while an open call is still looking for a taker. Directed offers
  // name their target from the start; an open call fills this in at the
  // moment somebody claims it, so the row also records who took it.
  toAssignmentId   String?
  toAssignment     ChoreAssignment? @relation("SwapTo", fields: [toAssignmentId], references: [id], onDelete: Cascade)
  status           SwapStatus @default(PENDING)
  createdAt        DateTime   @default(now())
  resolvedAt       DateTime?

  passes ChoreSwapPass[]

  @@index([groupId, status])
  @@index([toAssignmentId, status])
  @@index([fromAssignmentId, status])
}

// "Not me." Someone saying out loud that they won't take an open call.
//
// Without this, silence means two different things — nobody has looked, or
// everybody has refused — and the person asking has no way to tell which. A
// row per person turns that into a count, and once everyone has passed the
// call closes with an answer instead of hanging there indefinitely.
//
// Its own table rather than an array column: several people can pass at once,
// and appending to an array loses writes when two land together.
model ChoreSwapPass {
  id        String   @id @default(cuid())
  requestId String
  request   ChoreSwapRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([requestId, userId])
  @@index([requestId])
}

model AvailabilityEntry {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  label     String?
  recurring Boolean  @default(false)

  @@index([groupId, startsAt])
}

model Proposal {
  id                     String         @id @default(cuid())
  groupId                String
  group                  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposedById           String
  proposedBy             User           @relation("ProposalCreator", fields: [proposedById], references: [id])
  title                  String
  estimatedCostPerPerson Decimal?       @db.Decimal(10, 2)
  dietaryTags            String[]       @default([])
  latitude               Float?
  longitude              Float?
  status                 ProposalStatus @default(PROPOSED)
  createdAt              DateTime       @default(now())

  flags ProposalFlag[]
  votes ProposalVote[]

  @@index([groupId])
}

model ProposalFlag {
  id         String     @id @default(cuid())
  proposalId String
  proposal   Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  reason     FlagReason
  detail     String

  @@index([proposalId])
}

model ProposalVote {
  id         String     @id @default(cuid())
  proposalId String
  proposal   Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  choice     VoteChoice
  createdAt  DateTime   @default(now())

  @@unique([proposalId, userId])
  @@index([proposalId])
}

model Nudge {
  id           String       @id @default(cuid())
  settlementId String
  settlement   Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  sentAt       DateTime     @default(now())
  channel      NudgeChannel @default(EMAIL)

  @@index([settlementId])
}

model Recap {
  id               String   @id @default(cuid())
  groupId          String
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  month            DateTime
  summaryText      String
  totalSpentCents  Int
  choresCompleted  Int
  proposalsDecided Int
  topExpenses      Json
  choreMvpName     String?
  bigSpenderName   String?
  createdAt        DateTime @default(now())

  @@unique([groupId, month])
  @@index([groupId, month])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  groupId   String
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  @@index([groupId, createdAt])
}
