# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Planning docs, specs and agent notes — the thinking behind the build stays
# local. Ignoring every markdown file rather than naming them one by one, so
# new notes are covered automatically. AGENTS.md/CLAUDE.md are the exception:
# they're functional project config (this repo's own breaking-API warning),
# not private notes, so they're un-ignored below and stay tracked.
*.md
!AGENTS.md
!CLAUDE.md
docs/
